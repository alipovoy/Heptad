# XcodeGen output — deliberate, do not remove
#
# `project.yml` is the source of truth. Both entries below are generated by
# `xcodegen generate` and are never committed; a fresh clone has neither.
*.xcodeproj
**/Info.plist

# Build products
build/
DerivedData/
*.hmap
*.ipa
*.dSYM/
*.dSYM.zip

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved

# Local environment
.env
.env.*
.env/
*.log

# Local agent and planning notes — never publish
.claude/
CLAUDE.md
AGENTS.md
TODO*.md
TASKS.md
NOTES.md

# macOS
.DS_Store
